<Application x:Class="MeetingRecorder.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!--
                Every colour, type ramp and control template lives in one place.
                Keeping it out of App.xaml means the design system can be read as
                a document rather than as application plumbing.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
