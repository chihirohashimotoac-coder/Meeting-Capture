<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MeetingRecorder.App</RootNamespace>
    <AssemblyName>MeetingRecorder</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      Portable distribution: the ZIP is unpacked anywhere and MeetingRecorder.exe
      is started directly. No installer, no admin rights, no pre-installed
      runtime - so the publish is self-contained.
    -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
    <!--
      Trimming is off deliberately: WPF is not trim-compatible, and both
      Whisper.net and LLamaSharp resolve native assets and types reflectively.
      A slightly larger ZIP is a fair price for a build that actually runs.
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en;ja</SatelliteResourceLanguages>

    <!-- No telemetry of any kind reaches the network from this application. -->
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
  </PropertyGroup>

  <!--
    llama.cpp ships four CPU variants (noavx / avx / avx2 / avx512) of the same
    five DLLs. A RID-specific publish normally flattens everything under
    runtimes/<rid>/native/ into the output root, so the four variants collide on
    one file name and the SDK fails with NETSDK1152.

    Flattening would also be wrong even if it succeeded: whichever variant won
    would be the only one shipped, and an AVX-512 binary on a machine without
    AVX-512 crashes with an illegal instruction. LLamaSharp is designed to probe
    runtimes/<rid>/native/<variant>/ at run time and fall back down the list, so
    the fix is to keep that layout instead of collapsing it.
  -->
  <Target Name="PreserveLlamaCppRuntimeLayout" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_LlamaCppNative Include="@(ResolvedFileToPublish)"
                       Condition="'%(ResolvedFileToPublish.NuGetPackageId)' == 'LLamaSharp.Backend.Cpu'" />
      <ResolvedFileToPublish Remove="@(_LlamaCppNative)" />
      <ResolvedFileToPublish Include="@(_LlamaCppNative)">
        <RelativePath>%(_LlamaCppNative.PathInPackage)</RelativePath>
      </ResolvedFileToPublish>
    </ItemGroup>
    <Message Importance="high"
             Text="llama.cpp native layout preserved for @(_LlamaCppNative->Count()) file(s)." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\MeetingRecorder.Core\MeetingRecorder.Core.csproj" />
    <ProjectReference Include="..\MeetingRecorder.Audio\MeetingRecorder.Audio.csproj" />
    <ProjectReference Include="..\MeetingRecorder.Stt\MeetingRecorder.Stt.csproj" />
    <ProjectReference Include="..\MeetingRecorder.Diarization\MeetingRecorder.Diarization.csproj" />
    <ProjectReference Include="..\MeetingRecorder.Minutes\MeetingRecorder.Minutes.csproj" />
  </ItemGroup>

</Project>
