<Window x:Class="MeetingRecorder.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeetingRecorder — 会議録音・文字起こし"
        Height="780" Width="1220" MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Command bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" MaxWidth="420" HorizontalAlignment="Left" Margin="0,0,24,0">
                <TextBlock Text="会議名" Style="{StaticResource SectionHeader}" />
                <TextBox Text="{Binding MeetingTitle, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsIdle}" />
            </StackPanel>

            <Button Grid.Column="1" Command="{Binding StartCommand}"
                    Style="{StaticResource RecordButton}" MinWidth="128" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="●" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="録音開始" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Command="{Binding StopCommand}"
                    MinWidth="120" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="■" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="録音停止" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Grid.Column="3" Content="音声ファイルをインポート..."
                    Command="{Binding ImportAudioCommand}"
                    VerticalAlignment="Bottom"
                    ToolTip="WAV / MP3 / M4A / AAC を読み込みます。元のファイルは変更しません。" />

            <Button Grid.Column="4" Content="設定" Command="{Binding OpenSettingsCommand}"
                    Style="{StaticResource QuietButton}" MinWidth="72" Margin="0"
                    VerticalAlignment="Bottom" />
        </Grid>

        <!-- Warning banner -->
        <Border Grid.Row="1" Margin="0,0,0,16">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Banner}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasWarning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding WarningText}" Foreground="{StaticResource WarningTextBrush}" />
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="356" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Status column -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="20,18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="状態" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding StateText}" Style="{StaticResource TitleText}" />
                        <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource DisplayText}"
                                   Margin="0,2,0,10" />
                        <TextBlock Text="{Binding NextStepText}" Style="{StaticResource CaptionText}"
                                   Margin="0,0,0,24" />

                        <TextBlock Text="マイク" Style="{StaticResource SectionHeader}" />
                        <ProgressBar Minimum="0" Maximum="1"
                                     Value="{Binding MicLevel, Mode=OneWay}"
                                     Foreground="{StaticResource MeterFillBrush}"
                                     Margin="0,0,0,6" />
                        <TextBlock Text="{Binding MicLevelText}" Style="{StaticResource CaptionText}"
                                   Margin="0,0,0,10" />
                        <CheckBox Content="マイクをミュート（PC内部音声のみ録音）"
                                  IsChecked="{Binding MicrophoneMuted}"
                                  ToolTip="録音中でも切り替えられます。ミュート中の音声はファイルにも文字起こしにも入りません。"
                                  Margin="0,0,0,20" />

                        <TextBlock Text="PC内部音声 (WASAPIループバック)" Style="{StaticResource SectionHeader}" />
                        <ProgressBar Minimum="0" Maximum="1"
                                     Value="{Binding SystemLevel, Mode=OneWay}"
                                     Foreground="{StaticResource MeterFillBrush}"
                                     Margin="0,0,0,6" />
                        <TextBlock Text="{Binding SystemLevelText}" Style="{StaticResource CaptionText}"
                                   Margin="0,0,0,10" />
                        <CheckBox Content="PC内部音声をミュート（マイクのみ録音）"
                                  IsChecked="{Binding SystemAudioMuted}"
                                  ToolTip="録音中でも切り替えられます。ミュート中の音声はファイルにも文字起こしにも入りません。"
                                  Margin="0,0,0,8" />

                        <TextBlock Text="{Binding MuteWarningText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                                    <Setter Property="Margin" Value="0,0,0,20" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMuteWarning}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border Background="{StaticResource BorderBrush}" Height="1" Margin="0,0,0,20" />

                        <TextBlock Text="読み込まれている音声" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding AudioSummaryText}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding ModelText}" Style="{StaticResource CaptionText}"
                                   Margin="0,0,0,24" />

                        <TextBlock Text="保存先" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding SaveRootText}" Margin="0,0,0,12"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Button Content="保存先を開く" Command="{Binding OpenFolderCommand}" MinWidth="110" />
                            <Button Content="音声を出力..." Command="{Binding ExportAudioCommand}"
                                    MinWidth="110" Margin="0"
                                    ToolTip="直前の録音を、任意の場所にコピーします。" />
                        </StackPanel>

                        <TextBlock Text="診断情報" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource InsetCard}" CornerRadius="8" Padding="12,10">
                            <TextBlock Text="{Binding DiagnosticsText}" Style="{StaticResource MonoCaptionText}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Transcript -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="文字起こし" Style="{StaticResource GroupHeader}" />
                        <TextBlock Text="録音停止後・またはインポート後に手動で実行します。本文は直接編集できます。"
                                   Style="{StaticResource CaptionText}" />
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             x:Name="TranscriptList"
                             ItemsSource="{Binding Transcript}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Timestamp}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />
                                        <Border Background="{StaticResource SubtleSurfaceBrush}"
                                                CornerRadius="4" Padding="7,2">
                                            <TextBlock Text="{Binding SourceLabel}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource InlineEditor}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <Border Margin="0,0,0,12"
                                Background="{StaticResource AccentSubtleBrush}"
                                CornerRadius="10"
                                Padding="14,11">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTranscribing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding TranscriptionStatus}"
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,0,0,7" />
                                    <ProgressBar Minimum="0" Maximum="1" Height="6"
                                                 Background="#DCE6FB"
                                                 Value="{Binding TranscriptionProgress, Mode=OneWay}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="中止"
                                        Command="{Binding CancelTranscriptionCommand}"
                                        MinWidth="84" Margin="0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="文字起こし"
                                    Command="{Binding TranscribeCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="140"
                                    ToolTip="録音済みまたはインポート済みの音声を、このPC内で文字起こしします。録音中は実行できません。何度でも実行でき、そのたびに結果が置き換わります。" />
                            <Button Content="文字起こしを保存" Command="{Binding SaveTranscriptCommand}" MinWidth="140" />
                            <Button Content="話者名を編集"
                                    Command="{Binding RenameSpeakerCommand}"
                                    MinWidth="130"
                                    ToolTip="このアプリで録音した会議のみ。インポートした音声は音源が1つのため話者を特定できません。" />
                            <Button Content="議事録を生成（実験的）"
                                    Command="{Binding GenerateMinutesCommand}"
                                    MinWidth="180" Margin="0"
                                    ToolTip="文字起こしの結果から作成します。先に文字起こしを実行してください。" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar. The colophon sits in the corner it can be ignored from. -->
        <Grid Grid.Row="3" Margin="2,14,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding StatusMessage}"
                       Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,16,0" />

            <TextBlock Grid.Column="1"
                       Text="© chihiro hashimoto"
                       Style="{StaticResource ColophonText}"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
