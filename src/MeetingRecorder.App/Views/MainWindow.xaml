<Window x:Class="MeetingRecorder.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeetingRecorder — 会議録音・文字起こし"
        Height="760" Width="1180" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Command bar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="会議名" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1"
                     Text="{Binding MeetingTitle, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsIdle}"
                     VerticalAlignment="Center"
                     Margin="0,0,16,0" />

            <Button Grid.Column="2" Content="● 録音開始" Command="{Binding StartCommand}" FontWeight="Bold" />
            <Button Grid.Column="3" Content="■ 録音停止" Command="{Binding StopCommand}" />
            <Button Grid.Column="4" Content="設定" Command="{Binding OpenSettingsCommand}" Margin="0" />
        </Grid>

        <!-- Warning banner -->
        <Border Grid.Row="1"
                Background="{StaticResource WarningBrush}"
                BorderBrush="{StaticResource WarningBorderBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="10,6"
                Margin="0,0,0,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasWarning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding WarningText}" />
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Status column -->
            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="14"
                    Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="状態" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding StateText}" FontSize="20" FontWeight="Bold" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding ElapsedText}" FontSize="30" FontFamily="Consolas" Margin="0,0,0,16" />

                        <TextBlock Text="マイク" Style="{StaticResource SectionHeader}" />
                        <Grid Height="16" Margin="0,0,0,2">
                            <Rectangle Fill="{StaticResource MeterBackgroundBrush}" RadiusX="2" RadiusY="2" />
                            <ProgressBar Minimum="0" Maximum="1"
                                         Value="{Binding MicLevel, Mode=OneWay}"
                                         Foreground="{StaticResource MeterFillBrush}"
                                         Background="Transparent"
                                         BorderThickness="0" />
                        </Grid>
                        <TextBlock Text="{Binding MicLevelText}" FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" />

                        <TextBlock Text="PC内部音声 (WASAPIループバック)" Style="{StaticResource SectionHeader}" />
                        <Grid Height="16" Margin="0,0,0,2">
                            <Rectangle Fill="{StaticResource MeterBackgroundBrush}" RadiusX="2" RadiusY="2" />
                            <ProgressBar Minimum="0" Maximum="1"
                                         Value="{Binding SystemLevel, Mode=OneWay}"
                                         Foreground="{StaticResource MeterFillBrush}"
                                         Background="Transparent"
                                         BorderThickness="0" />
                        </Grid>
                        <TextBlock Text="{Binding SystemLevelText}" FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,16" />

                        <TextBlock Text="文字起こし" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding SttLatencyText}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding ModelText}" Margin="0,0,0,16"
                                   Foreground="{StaticResource MutedTextBrush}" />

                        <TextBlock Text="保存先" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding SaveRootText}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis" />
                        <Button Content="保存先を開く" Command="{Binding OpenFolderCommand}"
                                HorizontalAlignment="Left" Margin="0,0,0,16" />

                        <TextBlock Text="診断情報" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding DiagnosticsText}" FontSize="11" FontFamily="Consolas"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Transcript -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="リアルタイム文字起こし（本文は直接編集できます）"
                           Style="{StaticResource SectionHeader}" />

                <ListBox Grid.Row="1"
                         x:Name="TranscriptList"
                         ItemsSource="{Binding Transcript}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Timestamp}" FontFamily="Consolas"
                                               Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding SourceLabel}" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="文字起こしを保存" Command="{Binding SaveTranscriptCommand}" />
                    <Button Content="話者名を編集" Command="{Binding RenameSpeakerCommand}" />
                    <Button Content="議事録を生成（実験的）" Command="{Binding GenerateMinutesCommand}" MinWidth="180" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Margin="0,10,0,0" Padding="0,6,0,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
