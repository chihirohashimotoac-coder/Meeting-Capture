<Window x:Class="MeetingRecorder.App.Views.ModelDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIモデルのダウンロード"
        Height="520" Width="700"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,12" FontWeight="SemiBold"
                   Text="このアプリが外部へ通信するのは、以下のAIモデルのダウンロードのみです。会議の音声・文字起こし・議事録が送信されることはありません。" />

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="3" Padding="12" Background="{StaticResource PanelBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="モデル名" Margin="0,0,8,6" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="NameText" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="用途" Margin="0,0,8,6" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PurposeText" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="配布元" Margin="0,0,8,6" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PublisherText" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="URL" Margin="0,0,8,6" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="UrlText" Margin="0,0,0,6" FontSize="11" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="ファイルサイズ" Margin="0,0,8,6" />
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SizeText" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="保存先" Margin="0,0,8,6" />
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="DestinationText" Margin="0,0,0,6" FontSize="11" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="ライセンス" Margin="0,0,8,6" />
                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="LicenseText" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="整合性確認" Margin="0,0,8,6" />
                    <TextBlock Grid.Row="7" Grid.Column="1" x:Name="IntegrityText" Margin="0,0,0,6" FontSize="11" />
                </Grid>
            </ScrollViewer>
        </Border>

        <ProgressBar Grid.Row="2" x:Name="Progress" Height="18" Margin="0,12,0,6" Minimum="0" Maximum="1" />

        <TextBlock Grid.Row="3" x:Name="ProgressText" Foreground="{StaticResource MutedTextBrush}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="DownloadButton" Content="ダウンロード開始" Click="OnDownload" MinWidth="150" />
            <Button x:Name="CloseButton" Content="キャンセル" Click="OnClose" IsCancel="True" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
