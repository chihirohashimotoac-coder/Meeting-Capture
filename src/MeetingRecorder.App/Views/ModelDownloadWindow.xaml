<Window x:Class="MeetingRecorder.App.Views.ModelDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIモデルのダウンロード"
        Height="560" Width="740"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}"
        ShowInTaskbar="False">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="AIモデルのダウンロード" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource CaptionText}"
                       Text="このアプリが外部へ通信するのは、以下のAIモデルのダウンロードのみです。会議の音声・文字起こし・議事録が送信されることはありません。" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,18">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="モデル名" Style="{StaticResource SectionHeader}" Margin="0,0,16,10" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="NameText" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="用途" Style="{StaticResource SectionHeader}" Margin="0,0,16,10" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PurposeText" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="配布元" Style="{StaticResource SectionHeader}" Margin="0,0,16,10" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PublisherText" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="URL" Style="{StaticResource SectionHeader}" Margin="0,0,16,10" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="UrlText" Style="{StaticResource MonoCaptionText}" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="ファイルサイズ" Style="{StaticResource SectionHeader}" Margin="0,0,16,10" />
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SizeText" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="保存先" Style="{StaticResource SectionHeader}" Margin="0,0,16,10" />
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="DestinationText" Style="{StaticResource MonoCaptionText}" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="ライセンス" Style="{StaticResource SectionHeader}" Margin="0,0,16,10" />
                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="LicenseText" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="整合性確認" Style="{StaticResource SectionHeader}" Margin="0,0,16,0" />
                    <TextBlock Grid.Row="7" Grid.Column="1" x:Name="IntegrityText" Style="{StaticResource MonoCaptionText}" />
                </Grid>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Margin="2,16,2,0">
            <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="1" Margin="0,0,0,8" />
            <TextBlock x:Name="ProgressText" Style="{StaticResource CaptionText}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CloseButton" Content="キャンセル" Click="OnClose" IsCancel="True" MinWidth="110" />
            <Button x:Name="DownloadButton" Content="ダウンロード開始" Click="OnDownload"
                    Style="{StaticResource PrimaryButton}" MinWidth="160" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
