<Window x:Class="MeetingRecorder.App.Views.PreflightDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="録音開始前チェック"
        Height="520" Width="760"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="SummaryText" Margin="0,0,0,12" FontWeight="SemiBold" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ResultsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Icon}" FontSize="15" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Remedy}" Foreground="{StaticResource MutedTextBrush}"
                                           Visibility="{Binding RemedyVisibility}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ProceedButton" Content="このまま録音を開始" Click="OnProceed" MinWidth="160" />
            <Button x:Name="CancelButton" Content="キャンセル" Click="OnCancel" IsCancel="True" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
