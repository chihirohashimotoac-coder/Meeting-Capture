<Window x:Class="MeetingRecorder.App.Views.PreflightDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="録音開始前チェック"
        Height="560" Width="800"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}"
        ShowInTaskbar="False">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="録音開始前チェック" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource CaptionText}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Margin="0,0,-10,0" Padding="0,0,10,0">
            <ItemsControl x:Name="ResultsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Icon}" FontSize="15" Margin="0,0,10,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Remedy}"
                                           Style="{StaticResource CaptionText}"
                                           Visibility="{Binding RemedyVisibility}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="キャンセル" Click="OnCancel" IsCancel="True" MinWidth="110" />
            <Button x:Name="ProceedButton" Content="このまま録音を開始" Click="OnProceed"
                    Style="{StaticResource PrimaryButton}" MinWidth="180" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
