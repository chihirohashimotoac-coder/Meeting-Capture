<Window x:Class="MeetingRecorder.App.Views.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="前回の会議データの復旧"
        Height="460" Width="720"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,12" FontWeight="SemiBold"
                   Text="正常に終了しなかった会議が見つかりました。録音データは保存されています。文字起こしと議事録ファイルを復旧しますか？" />

        <ListView Grid.Row="1" x:Name="MeetingList" SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="会議" Width="240" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="開始日時" Width="170" DisplayMemberBinding="{Binding Started}" />
                    <GridViewColumn Header="録音時間" Width="110" DisplayMemberBinding="{Binding Duration}" />
                    <GridViewColumn Header="発言数" Width="90" DisplayMemberBinding="{Binding Segments}" />
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="2" x:Name="StatusText" Margin="0,10,0,0"
                   Foreground="{StaticResource MutedTextBrush}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="すべて復旧する" Click="OnRecoverAll" MinWidth="150" />
            <Button Content="後で確認する" Click="OnLater" MinWidth="130" />
            <Button Content="復旧しない（音声は残す）" Click="OnDismiss" MinWidth="200" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
