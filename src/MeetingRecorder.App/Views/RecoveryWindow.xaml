<Window x:Class="MeetingRecorder.App.Views.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="前回の会議データの復旧"
        Height="500" Width="780"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="前回の会議データの復旧" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource CaptionText}"
                       Text="正常に終了しなかった会議が見つかりました。録音データは保存されています。文字起こしと議事録ファイルを復旧しますか？" />
        </StackPanel>

        <ListView Grid.Row="1" x:Name="MeetingList" SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="会議" Width="260" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="開始日時" Width="180" DisplayMemberBinding="{Binding Started}" />
                    <GridViewColumn Header="録音時間" Width="120" DisplayMemberBinding="{Binding Duration}" />
                    <GridViewColumn Header="発言数" Width="100" DisplayMemberBinding="{Binding Segments}" />
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="2" x:Name="StatusText" Style="{StaticResource CaptionText}"
                   Margin="2,14,2,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="復旧しない（音声は残す）" Click="OnDismiss"
                    Style="{StaticResource QuietButton}" MinWidth="200" />
            <Button Content="後で確認する" Click="OnLater" MinWidth="130" />
            <Button Content="すべて復旧する" Click="OnRecoverAll"
                    Style="{StaticResource PrimaryButton}" MinWidth="150" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
