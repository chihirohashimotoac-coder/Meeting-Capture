<Window x:Class="MeetingRecorder.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定"
        Height="760" Width="880"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="設定" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Margin="0,0,-10,0" Padding="0,0,10,0">
            <StackPanel>

                <!-- Audio devices -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="音声デバイス" Style="{StaticResource GroupHeader}" />
                        <TextBlock Text="録音に使う入力デバイスと、PC内部音声を取り出す再生デバイスを選びます。"
                                   Style="{StaticResource CaptionText}" Margin="0,0,0,16" />

                        <TextBlock Text="マイク（入力デバイス）" Style="{StaticResource SectionHeader}" />
                        <ComboBox x:Name="MicCombo" DisplayMemberPath="Name" Margin="0,0,0,14" />

                        <TextBlock Text="PC内部音声を取得する再生デバイス（WASAPIループバック）"
                                   Style="{StaticResource SectionHeader}" />
                        <ComboBox x:Name="RenderCombo" DisplayMemberPath="Name" Margin="0,0,0,14" />

                        <CheckBox x:Name="FollowDefaultCheck" Margin="0,0,0,14"
                                  Content="デバイスが切断された場合はWindowsの既定デバイスへ自動的に切り替える" />
                        <Button Content="デバイス一覧を再取得" Click="OnRefreshDevices"
                                HorizontalAlignment="Left" Margin="0" MinWidth="160" />
                    </StackPanel>
                </Border>

                <!-- Storage and format -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="保存先と録音形式" Style="{StaticResource GroupHeader}" />
                        <TextBlock Text="会議ごとにフォルダーが作られ、音声・文字起こし・議事録がその中に保存されます。"
                                   Style="{StaticResource CaptionText}" Margin="0,0,0,16" />

                        <TextBlock Text="保存先" Style="{StaticResource SectionHeader}" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="SaveRootBox" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Grid.Column="1" Content="参照..." Click="OnBrowseSaveRoot" Margin="0" MinWidth="88" />
                        </Grid>

                        <TextBlock Text="録音形式" Style="{StaticResource SectionHeader}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="WavRadio" Content="WAV（48kHz/16bit/モノラル・約338MB/時）"
                                         GroupName="Format" VerticalAlignment="Center" Margin="0,0,24,0" />
                            <RadioButton x:Name="Mp3Radio" Content="MP3（96kbps・約43MB/時）"
                                         GroupName="Format" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="Mp3AvailabilityText" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Border>

                <!-- Transcription -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="文字起こし" Style="{StaticResource GroupHeader}" />
                        <TextBlock Text="完全ローカル処理です。録音中に文字起こしは行いません。録音を停止したあと、または音声ファイルをインポートしたあとに「文字起こし」を押したときだけ実行します。"
                                   Style="{StaticResource CaptionText}" Margin="0,0,0,16" />

                        <CheckBox x:Name="SttEnabledCheck" Content="文字起こし機能を使う" Margin="0,0,0,16" />

                        <TextBlock Text="文字起こしに使用するモデル" Style="{StaticResource SectionHeader}" />
                        <ComboBox x:Name="ModelCombo" DisplayMemberPath="Label" Margin="0,0,0,6" />
                        <TextBlock x:Name="ModelEstimateText" Style="{StaticResource CaptionText}"
                                   Margin="0,0,0,14" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="モデルをダウンロード" Click="OnDownloadModel" MinWidth="170" />
                            <Button Content="PC性能を測定して自動設定" Click="OnBenchmark" MinWidth="210" Margin="0" />
                        </StackPanel>

                        <TextBlock x:Name="ProfileText" Style="{StaticResource CaptionText}" Margin="0,0,0,18" />

                        <Border Style="{StaticResource InsetCard}" CornerRadius="8" Padding="14,12">
                            <StackPanel>
                                <CheckBox x:Name="KeepRecognitionAudioCheck" Margin="0,0,0,6"
                                          Content="文字起こし用の音声を保存する（マイクとPC音声を別々に保持）" />
                                <TextBlock Text="録音中に、マイクとPC内部音声を1系統あたり毎時およそ115MBの作業用音声として会議フォルダーに保存します。混ぜてしまうと発言元の区別は二度と復元できないため、この保存を切ると録音後の文字起こしはできません（録音そのものは通常どおり行われます）。"
                                           Style="{StaticResource CaptionText}" Margin="28,0,0,14" />

                                <CheckBox x:Name="DeleteRecognitionAudioCheck" Margin="28,0,0,6"
                                          Content="文字起こしが完了したら作業用音声を削除する" />
                                <TextBlock Text="正常に完了したときだけ削除します。失敗・中止のときは削除しません。削除すると、別のモデルでの再文字起こしはできなくなります（インポートした音声は、元のファイルが残っていれば作り直せます）。"
                                           Style="{StaticResource CaptionText}" Margin="56,0,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Experimental -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="実験的機能" Style="{StaticResource GroupHeader}" />
                        <TextBlock Text="精度は限定的です。結果は必ず確認してください。"
                                   Style="{StaticResource CaptionText}" Margin="0,0,0,16" />

                        <CheckBox x:Name="DiarizationCheck" Margin="0,0,0,6"
                                  Content="話者分離を有効にする（文字起こし時に実行。精度は限定的です）" />
                        <TextBlock Text="このアプリで録音した会議でのみ動作し、文字起こしの実行中に行われます（録音中は実行しません）。インポートした音声は音源が1つのため、話者の推定は行いません。"
                                   Style="{StaticResource CaptionText}" Margin="28,0,0,16" />

                        <CheckBox x:Name="MinutesCheck" Margin="0,0,0,16"
                                  Content="ローカルLLMによる議事録生成を有効にする（録音停止後に手動実行）" />

                        <TextBlock Text="議事録生成に使用するモデル" Style="{StaticResource SectionHeader}" />
                        <ComboBox x:Name="LlmCombo" DisplayMemberPath="Label" Margin="0,0,0,12" />
                        <Button Content="議事録用モデルをダウンロード" Click="OnDownloadLlm"
                                HorizontalAlignment="Left" Margin="0" MinWidth="220" />
                    </StackPanel>
                </Border>

                <!-- Behaviour -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="動作" Style="{StaticResource GroupHeader}" />
                        <TextBlock Text="録音中のふるまいと、録音データの保存方法です。"
                                   Style="{StaticResource CaptionText}" Margin="0,0,0,16" />

                        <CheckBox x:Name="SleepCheck" Content="録音中はWindowsのスリープを抑制する" Margin="0,0,0,16" />

                        <CheckBox x:Name="AutoSaveRecordingCheck" Margin="0,0,0,6"
                                  Content="録音データを会議フォルダーへ自動保存する" />
                        <TextBlock Text="オフにすると、録音は作業用フォルダーに残したまま会議フォルダーには保存されません。「音声を出力...」で保存先を選んでください。オフでも録音中は常にディスクへ書き込むため、クラッシュしてもデータは残ります。"
                                   Style="{StaticResource CaptionText}" Margin="28,0,0,16" />

                        <CheckBox x:Name="MicMutedCheck" Margin="0,0,0,10"
                                  Content="既定でマイクをミュートする（PC内部音声のみ録音）" />
                        <CheckBox x:Name="SystemMutedCheck" Margin="0,0,0,16"
                                  Content="既定でPC内部音声をミュートする（マイクのみ録音）" />

                        <TextBlock Text="自動保存間隔（秒）" Style="{StaticResource SectionHeader}" />
                        <TextBox x:Name="AutoSaveBox" Width="88" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Paths -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="保存場所" Style="{StaticResource GroupHeader}" Margin="0,0,0,12" />
                        <TextBlock x:Name="PathsText" Style="{StaticResource MonoCaptionText}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="StatusText" Style="{StaticResource CaptionText}"
                   Margin="2,16,2,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="キャンセル" Click="OnCancel" IsCancel="True" MinWidth="110" />
            <Button Content="保存して閉じる" Click="OnSave"
                    Style="{StaticResource PrimaryButton}" MinWidth="150" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
