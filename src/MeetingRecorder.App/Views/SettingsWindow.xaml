<Window x:Class="MeetingRecorder.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定"
        Height="720" Width="820"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="音声デバイス" Style="{StaticResource SectionHeader}" FontSize="15" />

                <TextBlock Text="マイク（入力デバイス）" Margin="0,6,0,4" />
                <ComboBox x:Name="MicCombo" DisplayMemberPath="Name" Margin="0,0,0,10" />

                <TextBlock Text="PC内部音声を取得する再生デバイス（WASAPIループバック）" Margin="0,0,0,4" />
                <ComboBox x:Name="RenderCombo" DisplayMemberPath="Name" Margin="0,0,0,6" />

                <CheckBox x:Name="FollowDefaultCheck" Margin="0,0,0,4"
                          Content="デバイスが切断された場合はWindowsの既定デバイスへ自動的に切り替える" />
                <Button Content="デバイス一覧を再取得" Click="OnRefreshDevices" HorizontalAlignment="Left" Margin="0,0,0,18" />

                <TextBlock Text="保存先と録音形式" Style="{StaticResource SectionHeader}" FontSize="15" />

                <Grid Margin="0,6,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="SaveRootBox" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="参照..." Click="OnBrowseSaveRoot" Margin="0" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="録音形式" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <RadioButton x:Name="WavRadio" Content="WAV（48kHz/16bit/モノラル・約338MB/時）"
                                 GroupName="Format" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <RadioButton x:Name="Mp3Radio" Content="MP3（96kbps・約43MB/時）"
                                 GroupName="Format" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="Mp3AvailabilityText" FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,18" />

                <TextBlock Text="文字起こし（完全ローカル処理）" Style="{StaticResource SectionHeader}" FontSize="15" />

                <CheckBox x:Name="SttEnabledCheck" Content="リアルタイム文字起こしを有効にする" Margin="0,6,0,10" />

                <TextBlock Text="使用するモデル" Margin="0,0,0,4" />
                <ComboBox x:Name="ModelCombo" DisplayMemberPath="Label" Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="モデルをダウンロード" Click="OnDownloadModel" MinWidth="170" />
                    <Button Content="PC性能を測定して自動設定" Click="OnBenchmark" MinWidth="200" Margin="0" />
                </StackPanel>

                <TextBlock x:Name="ProfileText" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,0,0,12" />

                <CheckBox x:Name="RefineCheck" Margin="0,0,0,4"
                          Content="録音停止後に、より高精度なモデルで文字起こしをやり直す" />
                <TextBlock Text="録音中の文字起こしは速報として素早く表示し、停止後に本文を精度優先で作り直します。録音中は1ストリームあたり毎時約115MBの作業用音声を会議フォルダーに保存します。"
                           TextWrapping="Wrap" FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" Margin="20,0,0,6" />

                <CheckBox x:Name="DeleteRecognitionAudioCheck" Margin="20,0,0,6"
                          Content="やり直しが終わったら作業用音声を削除する" />

                <TextBlock x:Name="RefinementModelText" FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" Margin="20,0,0,18" />

                <TextBlock Text="実験的機能" Style="{StaticResource SectionHeader}" FontSize="15" />

                <CheckBox x:Name="DiarizationCheck" Margin="0,6,0,6"
                          Content="話者分離を有効にする（PC音声側の話者をSpeaker 1/2...に分類。精度は限定的です）" />
                <CheckBox x:Name="MinutesCheck" Margin="0,0,0,8"
                          Content="ローカルLLMによる議事録生成を有効にする（録音停止後に手動実行）" />

                <TextBlock Text="議事録生成に使用するモデル" Margin="0,0,0,4" />
                <ComboBox x:Name="LlmCombo" DisplayMemberPath="Label" Margin="0,0,0,8" />
                <Button Content="議事録用モデルをダウンロード" Click="OnDownloadLlm" HorizontalAlignment="Left" Margin="0,0,0,18" />

                <TextBlock Text="動作" Style="{StaticResource SectionHeader}" FontSize="15" />
                <CheckBox x:Name="SleepCheck" Content="録音中はWindowsのスリープを抑制する" Margin="0,6,0,6" />

                <CheckBox x:Name="AutoSaveRecordingCheck" Margin="0,0,0,4"
                          Content="録音データを会議フォルダーへ自動保存する" />
                <TextBlock Text="オフにすると、録音は作業用フォルダーに残したまま会議フォルダーには保存されません。「音声を出力...」で保存先を選んでください。オフでも録音中は常にディスクへ書き込むため、クラッシュしてもデータは残ります。"
                           TextWrapping="Wrap" FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" Margin="20,0,0,10" />

                <CheckBox x:Name="MicMutedCheck" Margin="0,0,0,4"
                          Content="既定でマイクをミュートする（PC内部音声のみ録音）" />
                <CheckBox x:Name="SystemMutedCheck" Margin="0,0,0,10"
                          Content="既定でPC内部音声をミュートする（マイクのみ録音）" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <TextBlock Text="自動保存間隔（秒）" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox x:Name="AutoSaveBox" Width="60" />
                </StackPanel>

                <TextBlock Text="保存場所" Style="{StaticResource SectionHeader}" FontSize="15" />
                <TextBlock x:Name="PathsText" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="1" x:Name="StatusText" Margin="0,10,0,0"
                   Foreground="{StaticResource MutedTextBrush}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存して閉じる" Click="OnSave" MinWidth="140" />
            <Button Content="キャンセル" Click="OnCancel" IsCancel="True" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
