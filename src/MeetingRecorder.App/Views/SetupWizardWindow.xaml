<Window x:Class="MeetingRecorder.App.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeetingRecorder — 初回設定"
        Height="740" Width="860"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="初回設定" FontSize="26" FontWeight="Light" Margin="0,0,0,8" />
            <TextBlock MaxWidth="640" HorizontalAlignment="Left"
                       Style="{StaticResource CaptionText}"
                       Text="録音に使用するデバイスと保存先を設定します。会議の音声・文字起こし・議事録が外部へ送信されることはありません。外部通信はAIモデルのダウンロード時のみ行われます。" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Margin="0,0,-10,0" Padding="0,0,10,0">
            <StackPanel>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="1. マイク（同じ部屋の参加者の音声）" Style="{StaticResource GroupHeader}"
                                   Margin="0,0,0,12" />
                        <ComboBox x:Name="MicCombo" DisplayMemberPath="Name" Margin="0,0,0,8" />
                        <TextBlock x:Name="MicStatusText" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="2. PC内部音声（Zoom / Teams / Meet などの再生音）"
                                   Style="{StaticResource GroupHeader}" Margin="0,0,0,12" />
                        <ComboBox x:Name="RenderCombo" DisplayMemberPath="Name" Margin="0,0,0,8" />
                        <TextBlock x:Name="RenderStatusText" Style="{StaticResource CaptionText}"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Text="WASAPIループバックで、選択した再生デバイスから出力される音声をそのまま録音します。仮想オーディオドライバのインストールや管理者権限は不要です。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="3. 保存先" Style="{StaticResource GroupHeader}" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="SaveRootBox" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Grid.Column="1" Content="参照..." Click="OnBrowse" Margin="0" MinWidth="88" />
                        </Grid>
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Text="会議ごとに「2026-09-07_1430_Meeting」のようなフォルダーが作成され、音声・文字起こし・議事録が保存されます。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="4. 音声認識モデル" Style="{StaticResource GroupHeader}" Margin="0,0,0,12" />
                        <TextBlock x:Name="ProfileText" Margin="0,0,0,12" />
                        <ComboBox x:Name="ModelCombo" DisplayMemberPath="Label" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="PC性能を測定" Click="OnBenchmark" MinWidth="130" />
                            <Button Content="モデルをダウンロード" Click="OnDownload" MinWidth="180" Margin="0" />
                        </StackPanel>
                        <TextBlock x:Name="ModelStatusText" Style="{StaticResource CaptionText}"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Text="モデルを取得しなくても録音は利用できます（その場合、文字起こしのみ行われません）。" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="StatusText" Style="{StaticResource CaptionText}"
                   Margin="2,16,2,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="終了" Click="OnQuit" Style="{StaticResource QuietButton}" MinWidth="88" />
            <Button Content="設定を保存して開始" Click="OnFinish"
                    Style="{StaticResource PrimaryButton}" MinWidth="190" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
