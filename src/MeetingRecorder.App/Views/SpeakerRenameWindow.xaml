<Window x:Class="MeetingRecorder.App.Views.SpeakerRenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="話者名の編集"
        Height="480" Width="600"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}"
        ShowInTaskbar="False">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="話者名の編集" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource CaptionText}"
                       Text="話者に名前を割り当てます。入力した名前は、この会議内の同じ話者の発言すべてに反映されます。アプリが人物名を推測することはありません。" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                <ItemsControl x:Name="SpeakerList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DefaultLabel}"
                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="キャンセル" Click="OnCancel" IsCancel="True" MinWidth="110" />
            <Button Content="反映して保存" Click="OnApply"
                    Style="{StaticResource PrimaryButton}" MinWidth="140" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
